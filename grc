#!/usr/bin/env bash
# grc - CLI wrapper for the GRC Bundle Review Pipeline
# Allows executing: `grc bundle restore ...` directly as documented in the review workflow.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Ensure Docker Desktop CLI locations on macOS are present in PATH
export PATH="${HOME}/.docker/bin:/usr/local/bin:/opt/homebrew/bin:/Applications/Docker.app/Contents/Resources/bin:${PATH}"

print_grcfetch() {
    local P="\033[38;5;135m"   # Purple ASCII art (matches VHS neofetch style)
    local M="\033[1;95m"       # Bright Magenta title
    local G="\033[1;32m"       # Bright Green keys
    local W="\033[0;37m"       # White values
    local D="\033[38;5;240m"   # Dim divider
    local R="\033[0m"          # Reset

    echo -e ""
    echo -e "  ${P}        .--.          .--.          .--.        ${R}"
    echo -e "  ${P}  ,p#G*\"\"TG#Gp, ,p#G*\"\"TG#Gp, ,p#G*\"\"TG#Gp,   ${M}eodartintlabs-hue/grc-bundle-reviewer${R}"
    echo -e "  ${P} {GGG'     \`G# {GGG     \`GGG {GGG'     \`G#    ${D}-------------------------------------${R}"
    echo -e "  ${P} @GGG          @GGG     ,GGG @GGG             ${G}App:${W} GRC Bundle Reviewer v1.0.2 (Yokosuka)${R}"
    echo -e "  ${P} 'GGG   ,p#GG# @GGG#**#GGG\"  'GGG             ${G}OS:${W} Darwin ARM64 / Linux Bookworm${R}"
    echo -e "  ${P}  GGG   \"\"\`GGG @GGG   \`GGG,   GGG             ${G}Model:${W} Out-of-Band (OOB) / Fail-Open${R}"
    echo -e "  ${P} ]GGG#     GGG @GGG    ]GGG  ]GGG#     ,G#    ${G}Isolation:${W} Air-Gapped (--network none, :ro)${R}"
    echo -e "  ${P}  @GGGb,,,dGGG @GGG     GGG,  @GGGb,,,dGG\"    ${G}Scanners:${W} (7) Semgrep, Gitleaks, Checkov,${R}"
    echo -e "  ${P}   \`@GGGG###G# @GGG     \`GGG   \`@GGGG###G\"    ${W}              Syft, Grype, Trivy, OpenSCAP${R}"
    echo -e "  ${P}     \`\"%N>\"\`    \`\"%NW\" \`\"%NW\"    \`\"%N>\"\`      ${G}Ruleset:${W} 37 AST Rules (AOC 02–140)${R}"
    echo -e "  ${P}                                              ${G}Frameworks:${W} DISA STIG, NIST 800-53 R5, FedRAMP${R}"
    echo -e "  ${P}                                              ${G}Output:${W} POA&M, Controls, SCR/SCN, SHA-256${R}"
    echo -e ""
    echo -e "                                                \033[40m   \033[41m   \033[42m   \033[43m   \033[44m   \033[45m   \033[46m   \033[47m   ${R}"
    echo -e "                                                \033[100m   \033[101m   \033[102m   \033[103m   \033[104m   \033[105m   \033[106m   \033[107m   ${R}"
    echo -e ""
}

if [[ "$#" -eq 0 ]]; then
    print_grcfetch
    echo "Usage: ./grc <command> [arguments]"
    echo ""
    echo "Available Commands:"
    echo "  bundle restore <file.bundle>   Extract & verify bundle into ephemeral workspace"
    echo "  bundle verify  <file.bundle>   Cryptographic (SHA-256) and Git object validation"
    echo "  bundle clean   --workspace <w> Teardown ephemeral workspace & wipe bundle"
    echo "  ami restore    <ami-id>        Cold-mount AMI snapshot as read-only secondary volume"
    echo "  ami verify     <ami-id>        Validate AMI metadata, KMS encryption, and root snapshot"
    echo "  ami clean      --workspace <w> Teardown ephemeral volume & audit mount"
    echo "  sbom           --sbom <file>   Run DISA STIG / SRG SBOM analyzer"
    echo "  crypto         -w <workspace>  Scan cryptographic libraries & EOL versions"
    echo "  scan           -w <w> [-e <e>] Execute containerized security suite (Docker)"
    echo "  report         -e <evidence>   Synthesize Phase 4 SCR/SCN package & POA&M deliverables"
    echo "  docker-build                   Build the local grc-scanner:local Docker image"
    echo "  fetch | info                   Display the GRC Bundle Reviewer neofetch banner"
    echo "=========================================================="
    exit 1
fi

SUBCOMMAND="$1"
shift

case "${SUBCOMMAND}" in
    fetch|info|--version|-v)
        print_grcfetch
        ;;
    bundle)
        python3 "${SCRIPT_DIR}/scripts/grc_bundle.py" "$@"
        ;;
    ami)
        python3 "${SCRIPT_DIR}/scripts/grc_ami.py" "$@"
        ;;
    sbom)
        python3 "${SCRIPT_DIR}/scripts/sbom_analyzer.py" "$@"
        ;;
    crypto)
        python3 "${SCRIPT_DIR}/scripts/crypto_lib_scan.py" "$@"
        ;;
    report)
        python3 "${SCRIPT_DIR}/scripts/grc_reporter.py" "$@"
        ;;
    docker-build)
        echo "[*] Building local Docker image 'grc-scanner:local'..."
        docker build -t grc-scanner:local -f "${SCRIPT_DIR}/docker/Dockerfile.scanner" "${SCRIPT_DIR}"
        ;;
    scan)
        IMAGE_NAME="grc-scanner:local"
        if ! docker info >/dev/null 2>&1; then
            echo "[ERROR] Docker daemon is not running. Please start Docker for Mac."
            exit 1
        fi

        if ! docker image inspect "${IMAGE_NAME}" >/dev/null 2>&1; then
            echo "[*] Image '${IMAGE_NAME}' not found. Building now..."
            docker build -t "${IMAGE_NAME}" -f "${SCRIPT_DIR}/docker/Dockerfile.scanner" "${SCRIPT_DIR}"
        fi

        WORKSPACE_PATH="./ephemeral_workspace"
        EVIDENCE_PATH=""

        while [[ "$#" -gt 0 ]]; do
            case "$1" in
                -w|--workspace)
                    WORKSPACE_PATH="$2"
                    shift 2
                    ;;
                -e|--evidence)
                    EVIDENCE_PATH="$2"
                    shift 2
                    ;;
                *)
                    WORKSPACE_PATH="$1"
                    shift
                    ;;
            esac
        done

        RESOLVED_WORKSPACE="$(cd "${WORKSPACE_PATH}" 2>/dev/null && pwd || echo "${WORKSPACE_PATH}")"

        # Auto-namespace evidence directory by bundle name if provenance is present
        if [[ -n "${EVIDENCE_PATH}" ]]; then
            mkdir -p "${EVIDENCE_PATH}"
            RESOLVED_EVIDENCE="$(cd "${EVIDENCE_PATH}" && pwd)"
        elif [[ -f "${RESOLVED_WORKSPACE}/bundle_provenance.json" ]]; then
            BUNDLE_SOURCE="$(grep -o '"bundle_source_path": *"[^"]*"' "${RESOLVED_WORKSPACE}/bundle_provenance.json" | cut -d'"' -f4 || true)"
            if [[ -n "${BUNDLE_SOURCE}" ]]; then
                BUNDLE_BASE="$(basename "${BUNDLE_SOURCE}" .bundle)"
                RESOLVED_EVIDENCE="${SCRIPT_DIR}/evidence/${BUNDLE_BASE}"
            else
                RESOLVED_EVIDENCE="${SCRIPT_DIR}/evidence"
            fi
        else
            RESOLVED_EVIDENCE="${SCRIPT_DIR}/evidence"
        fi
        mkdir -p "${RESOLVED_EVIDENCE}"

        echo "[*] Target Workspace:   ${RESOLVED_WORKSPACE}"
        echo "[*] Evidence Directory: ${RESOLVED_EVIDENCE}"
        echo "[*] Executing isolated containerized scan..."
        docker run --rm \
            --network none \
            -v "${RESOLVED_WORKSPACE}:/workspace:ro" \
            -v "${SCRIPT_DIR}/rules:/rules:ro" \
            -v "${RESOLVED_EVIDENCE}:/evidence:rw" \
            "${IMAGE_NAME}" \
            /usr/local/bin/scan_orchestrator.sh

        echo ""
        echo "[*] Synthesizing Phase 4 Compliance Package (POA&M, Controls, Ruleset Log, Checksums)..."
        python3 "${SCRIPT_DIR}/scripts/grc_reporter.py" \
            --evidence "${RESOLVED_EVIDENCE}" \
            --workspace "${RESOLVED_WORKSPACE}" \
            --ruleset "${SCRIPT_DIR}/rules/custom-baseline-ruleset.yaml"
        ;;
    *)
        echo "[ERROR] Unknown GRC pipeline command: ${SUBCOMMAND}"
        echo "Run 'grc' without arguments to see available subcommands."
        exit 1
        ;;
esac
