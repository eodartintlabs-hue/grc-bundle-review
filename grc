#!/usr/bin/env bash
# grc - CLI wrapper for GRCx ("The GRC eXperience")
# Allows executing: `grc bundle restore ...` directly as documented in the review workflow.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Ensure Docker Desktop CLI locations on macOS are present in PATH
export PATH="${HOME}/.docker/bin:/usr/local/bin:/opt/homebrew/bin:/Applications/Docker.app/Contents/Resources/bin:${PATH}"

print_grcfetch() {
    local P="\033[38;5;135m"   # Purple ASCII art (matches VHS neofetch style)
    local M="\033[1;95m"       # Bright Magenta title
    local G="\033[1;32m"       # Bright Green keys
    local W="\033[0;37m"       # White values
    local D="\033[38;5;240m"   # Dim divider
    local R="\033[0m"          # Reset

    echo -e ""
    echo -e "  ${P}        .--.          .--.          .--.                       ${R}"
    echo -e "  ${P}  ,p#G*\"\"TG#Gp, ,p#G*\"\"TG#Gp, ,p#G*\"\"TG#Gp,                  ${M}eodartintlabs-hue/grcx${R}"
    echo -e "  ${P} {GGG'     \`G# {GGG     \`GGG {GGG'     \`G#                   ${D}----------------------${R}"
    echo -e "  ${P} @GGG          @GGG     ,GGG @GGG          ,p#Gp,   ,p#Gp,   ${G}App:${W} GRCx v1.3.0 (Sasebo)${R}"
    echo -e "  ${P} 'GGG   ,p#GG# @GGG#**#GGG\"  'GGG           \`GGG, ,GGG'      ${G}OS:${W} Darwin ARM64 / Linux Bookworm${R}"
    echo -e "  ${P}  GGG   \"\"\`GGG @GGG   \`GGG,   GGG             \`GGGGG'        ${G}Model:${W} Out-of-Band (OOB) / Fail-Open${R}"
    echo -e "  ${P} ]GGG#     GGG @GGG    ]GGG  ]GGG#     ,G#    ,GGGGG,        ${G}Isolation:${W} Air-Gapped (--network none, :ro)${R}"
    echo -e "  ${P}  @GGGb,,,dGGG @GGG     GGG,  @GGGb,,,dGG\"  ,GGG' \`GGG,      ${G}Engines:${W} (10) Semgrep, Gitleaks, Checkov, Syft,${R}"
    echo -e "  ${P}   \`@GGGG###G# @GGG     \`GGG   \`@GGGG###G\" dGGG'   \`GGGb     ${W}              Grype, Trivy, OpenSCAP, Crypto, SBOM, Transform${R}"
    echo -e "  ${P}     \`\"%N>\"\`    \`\"%NW\" \`\"%NW\"    \`\"%N>\"\`   \`\"%N\"   \"%N\"\`     ${G}Ruleset:${W} 37 AST Rules (AOC 02–140)${R}"
    echo -e "  ${P}                                                             ${G}Frameworks:${W} DISA STIG, NIST 800-53 R5, FedRAMP${R}"
    echo -e "  ${P}       ───  T h e   G R C   e X p e r i e n c e  ───         ${G}Output:${W} FedRAMP POA&M (.xlsx/.md), Controls, SCR/SCN${R}"
    echo -e ""
    echo -e "                                                               \033[40m   \033[41m   \033[42m   \033[43m   \033[44m   \033[45m   \033[46m   \033[47m   ${R}"
    echo -e "                                                               \033[100m   \033[101m   \033[102m   \033[103m   \033[104m   \033[105m   \033[106m   \033[107m   ${R}"
    echo -e ""
}

print_scan_help() {
    echo "Usage: ./grc scan [engine] -w <workspace> [-e <evidence_dir>] [--engine <name>] [--no-report]"
    echo ""
    echo "Scan Modes / Compliance Engines:"
    echo "  all  (--all)         Run ALL 9 compliance engines (Container Suite + Crypto + SBOM STIG) [Default]"
    echo "  semgrep (--semgrep)  Run Semgrep SAST against the 37-rule custom AOC baseline"
    echo "  gitleaks (--gitleaks)Run Gitleaks secret & private key detection"
    echo "  checkov (--checkov)  Run Checkov IaC (Terraform, K8s, Dockerfile, Ansible) scan"
    echo "  syft (--syft)        Run Syft CycloneDX SBOM generation (sbom.cdx.json)"
    echo "  grype (--grype)      Run Grype offline CVE matcher against CycloneDX SBOM"
    echo "  trivy (--trivy)      Run Trivy offline multi-target vulnerability scanner"
    echo "  oscap (--oscap)      Run OpenSCAP DISA STIG evaluation (AMI cold-mounts)"
    echo "  crypto (--crypto)    Run static cryptographic library & EOL version scanner (AOC-09)"
    echo "  sbom (--sbom)        Run DISA STIG / DoD SRG SBOM applicability mapper"
    echo ""
    echo "Options:"
    echo "  -w, --workspace <dir>  Target ephemeral workspace directory (default: ./ephemeral_workspace)"
    echo "  -e, --evidence <dir>   Output evidence directory (default: auto-namespaced under ./evidence/)"
    echo "  -t, --engine <name>    Compliance engine to execute (default: all)"
    echo "  --no-report            Skip automatic Phase 4 SCR/SCN report synthesis after scanning"
    echo "  -h, --help             Show this help message"
}

if [[ "$#" -eq 0 ]]; then
    print_grcfetch
    echo "Usage: ./grc <command> [arguments]"
    echo ""
    echo "Standalone GRC Analyst Workflow (No Docker or .bundle Required):"
    echo "  transform      [filename]      Drop scan (.csv/.xlsx) & previous POA&M (.xlsx) into"
    echo "                                 ./scans/ and run './grc transform' (lists files by"
    echo "                                 number or accepts filename without path/extension)"
    echo ""
    echo "5-Phase Bundle & AMI Audit Pipeline Commands:"
    echo "  bundle restore <file.bundle>   Extract & verify bundle into ephemeral workspace"
    echo "  bundle verify  <file.bundle>   Cryptographic (SHA-256) and Git object validation"
    echo "  bundle clean   --workspace <w> Teardown ephemeral workspace & wipe bundle"
    echo "  ami restore    <ami-id>        Cold-mount AMI snapshot as read-only secondary volume"
    echo "  ami verify     <ami-id>        Validate AMI metadata, KMS encryption, and root snapshot"
    echo "  ami clean      --workspace <w> Teardown ephemeral volume & audit mount"
    echo "  scan [engine]  -w <w> [-e <e>] Run all (--all) or individual (--engine <name>) compliance engines"
    echo "  report         -e <evidence>   Synthesize Phase 4 SCR/SCN package & POA&M deliverables"
    echo "  sbom           --sbom <file>   Direct CLI wrapper for DISA STIG / SRG SBOM analyzer"
    echo "  crypto         -w <workspace>  Direct CLI wrapper for cryptographic & EOL library scanner"
    echo "  docker-build                   Build the local grc-scanner:local Docker image"
    echo "  fetch | info                   Display the GRCx neofetch banner"
    echo "=========================================================="
    exit 1
fi

SUBCOMMAND="$1"
shift

case "${SUBCOMMAND}" in
    fetch|info|--version|-v)
        print_grcfetch
        ;;
    transform|ingest)
        python3 "${SCRIPT_DIR}/scripts/transform_scans.py" "$@"
        ;;
    bundle)
        python3 "${SCRIPT_DIR}/scripts/grc_bundle.py" "$@"
        ;;
    ami)
        python3 "${SCRIPT_DIR}/scripts/grc_ami.py" "$@"
        ;;
    sbom)
        python3 "${SCRIPT_DIR}/scripts/sbom_analyzer.py" "$@"
        ;;
    crypto)
        python3 "${SCRIPT_DIR}/scripts/crypto_lib_scan.py" "$@"
        ;;
    report)
        python3 "${SCRIPT_DIR}/scripts/grc_reporter.py" "$@"
        ;;
    docker-build)
        echo "[*] Building local Docker image 'grc-scanner:local'..."
        docker build -t grc-scanner:local -f "${SCRIPT_DIR}/docker/Dockerfile.scanner" "${SCRIPT_DIR}"
        ;;
    scan)
        WORKSPACE_PATH="./ephemeral_workspace"
        EVIDENCE_PATH=""
        SCAN_ENGINE="all"
        RUN_REPORT="true"

        while [[ "$#" -gt 0 ]]; do
            case "$1" in
                -h|--help)
                    print_scan_help
                    exit 0
                    ;;
                -w|--workspace)
                    WORKSPACE_PATH="$2"
                    shift 2
                    ;;
                -e|--evidence)
                    EVIDENCE_PATH="$2"
                    shift 2
                    ;;
                -t|--engine|--scanner)
                    SCAN_ENGINE="$(echo "$2" | tr '[:upper:]' '[:lower:]')"
                    shift 2
                    ;;
                --all)
                    SCAN_ENGINE="all"
                    shift
                    ;;
                --semgrep|--gitleaks|--checkov|--syft|--grype|--trivy|--oscap|--openscap|--crypto|--sbom|--stig)
                    SCAN_ENGINE="$(echo "${1#--}" | tr '[:upper:]' '[:lower:]')"
                    shift
                    ;;
                --no-report)
                    RUN_REPORT="false"
                    shift
                    ;;
                all|semgrep|gitleaks|checkov|syft|grype|trivy|oscap|openscap|crypto|sbom|stig)
                    SCAN_ENGINE="$(echo "$1" | tr '[:upper:]' '[:lower:]')"
                    shift
                    ;;
                *)
                    WORKSPACE_PATH="$1"
                    shift
                    ;;
            esac
        done

        # Normalize engine aliases
        case "${SCAN_ENGINE}" in
            openscap) SCAN_ENGINE="oscap" ;;
            stig)     SCAN_ENGINE="sbom" ;;
        esac

        RESOLVED_WORKSPACE="$(cd "${WORKSPACE_PATH}" 2>/dev/null && pwd || echo "${WORKSPACE_PATH}")"

        # Auto-namespace evidence directory by bundle name if provenance is present
        if [[ -n "${EVIDENCE_PATH}" ]]; then
            mkdir -p "${EVIDENCE_PATH}"
            RESOLVED_EVIDENCE="$(cd "${EVIDENCE_PATH}" && pwd)"
        elif [[ -f "${RESOLVED_WORKSPACE}/bundle_provenance.json" ]]; then
            BUNDLE_SOURCE="$(grep -o '"bundle_source_path": *"[^"]*"' "${RESOLVED_WORKSPACE}/bundle_provenance.json" | cut -d'"' -f4 || true)"
            if [[ -n "${BUNDLE_SOURCE}" ]]; then
                BUNDLE_BASE="$(basename "${BUNDLE_SOURCE}" .bundle)"
                RESOLVED_EVIDENCE="${SCRIPT_DIR}/evidence/${BUNDLE_BASE}"
            else
                RESOLVED_EVIDENCE="${SCRIPT_DIR}/evidence"
            fi
        else
            RESOLVED_EVIDENCE="${SCRIPT_DIR}/evidence"
        fi
        mkdir -p "${RESOLVED_EVIDENCE}"

        # Preserve chain-of-custody provenance in evidence directory across all engine modes
        if [[ -f "${RESOLVED_WORKSPACE}/bundle_provenance.json" ]]; then
            cp -f "${RESOLVED_WORKSPACE}/bundle_provenance.json" "${RESOLVED_EVIDENCE}/bundle_provenance.json"
        fi
        if [[ -f "${RESOLVED_WORKSPACE}/ami_provenance.json" ]]; then
            cp -f "${RESOLVED_WORKSPACE}/ami_provenance.json" "${RESOLVED_EVIDENCE}/ami_provenance.json"
        fi

        echo "[*] Target Workspace:   ${RESOLVED_WORKSPACE}"
        echo "[*] Evidence Directory: ${RESOLVED_EVIDENCE}"
        echo "[*] Compliance Engine:  ${SCAN_ENGINE}"

        run_container_engine() {
            local target_eng="$1"
            local IMAGE_NAME="grc-scanner:local"
            if ! docker info >/dev/null 2>&1; then
                echo "[ERROR] Docker daemon is not running. Please start Docker for Mac."
                exit 1
            fi
            if ! docker image inspect "${IMAGE_NAME}" >/dev/null 2>&1; then
                echo "[*] Image '${IMAGE_NAME}' not found. Building now..."
                docker build -t "${IMAGE_NAME}" -f "${SCRIPT_DIR}/docker/Dockerfile.scanner" "${SCRIPT_DIR}"
            fi
            echo "[*] Executing isolated containerized scan (engine: ${target_eng})..."
            docker run --rm \
                --network none \
                -v "${RESOLVED_WORKSPACE}:/workspace:ro" \
                -v "${SCRIPT_DIR}/rules:/rules:ro" \
                -v "${SCRIPT_DIR}/docker/scan_orchestrator.sh:/usr/local/bin/scan_orchestrator.sh:ro" \
                -v "${RESOLVED_EVIDENCE}:/evidence:rw" \
                "${IMAGE_NAME}" \
                /usr/local/bin/scan_orchestrator.sh "${target_eng}"
        }

        run_crypto_engine() {
            echo ""
            echo "[*] Executing Cryptographic Library & EOL Version Scanner (crypto_lib_scan.py)..."
            python3 "${SCRIPT_DIR}/scripts/crypto_lib_scan.py" \
                --workspace "${RESOLVED_WORKSPACE}" \
                --catalog "${SCRIPT_DIR}/rules/crypto_catalog.json" \
                --format json \
                --output "${RESOLVED_EVIDENCE}/crypto_findings.json" || true
        }

        run_sbom_engine() {
            echo ""
            if [[ ! -f "${RESOLVED_EVIDENCE}/sbom.cdx.json" ]]; then
                echo "[*] Prerequisite sbom.cdx.json not found in evidence directory; generating via Syft first..."
                run_container_engine "syft"
            fi
            if [[ -f "${RESOLVED_EVIDENCE}/sbom.cdx.json" ]]; then
                echo "[*] Executing DISA STIG / DoD SRG SBOM Applicability Mapper (sbom_analyzer.py)..."
                python3 "${SCRIPT_DIR}/scripts/sbom_analyzer.py" \
                    --sbom "${RESOLVED_EVIDENCE}/sbom.cdx.json" \
                    --format markdown \
                    --output "${RESOLVED_EVIDENCE}/stig_matrix.md"
                python3 "${SCRIPT_DIR}/scripts/sbom_analyzer.py" \
                    --sbom "${RESOLVED_EVIDENCE}/sbom.cdx.json" \
                    --format json \
                    --output "${RESOLVED_EVIDENCE}/stig_applicability.json"
            else
                echo "[!] Warning: sbom.cdx.json unavailable; skipping SBOM STIG mapping."
            fi
        }

        case "${SCAN_ENGINE}" in
            all)
                run_container_engine "all"
                run_crypto_engine
                run_sbom_engine
                ;;
            semgrep|gitleaks|checkov|syft|grype|trivy|oscap)
                run_container_engine "${SCAN_ENGINE}"
                ;;
            crypto)
                run_crypto_engine
                ;;
            sbom)
                run_sbom_engine
                ;;
            *)
                echo "[ERROR] Unknown scan engine '${SCAN_ENGINE}'."
                print_scan_help
                exit 1
                ;;
        esac

        if [[ "${RUN_REPORT}" == "true" ]]; then
            echo ""
            echo "[*] Synthesizing Phase 4 Compliance Package (POA&M, Controls, Ruleset Log, Checksums)..."
            python3 "${SCRIPT_DIR}/scripts/grc_reporter.py" \
                --evidence "${RESOLVED_EVIDENCE}" \
                --workspace "${RESOLVED_WORKSPACE}" \
                --ruleset "${SCRIPT_DIR}/rules/custom-baseline-ruleset.yaml"
        fi
        ;;
    *)
        echo "[ERROR] Unknown GRC pipeline command: ${SUBCOMMAND}"
        echo "Run './grc' without arguments to see available subcommands."
        exit 1
        ;;
esac
