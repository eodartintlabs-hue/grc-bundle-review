# syntax=docker/dockerfile:1
# ==============================================================================
# GRC Bundle Review Pipeline - Unified Local Security Scanner Suite
# ==============================================================================
# Target Architecture: Multi-Arch (linux/arm64 for Apple Silicon, linux/amd64)
# Frameworks: NIST SP 800-53 Rev. 5, FedRAMP High, DISA STIG
# Tools Included:
#   - Semgrep (SAST - 37 Custom Baseline AOC Rules)
#   - Checkov (IaC Security - Terraform, CloudFormation, Ansible, Dockerfiles)
#   - Gitleaks (Secret & Token Detection)
#   - Syft (Software Bill of Materials / SBOM Generator)
#   - Grype (Vulnerability Scanner for SBOMs & Dependencies)
#   - Trivy (Multi-Target Vulnerability & Misconfiguration Scanner)
#   - OpenSCAP (Offline DISA OS STIG Evaluator)
# ==============================================================================

FROM python:3.11-slim-bookworm

LABEL maintainer="GRC Compliance & DevSecOps Engineering"
LABEL description="Unified containerized security scanning suite for GRC Bundle & AMI reviews"
LABEL version="1.0.0"

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV PATH="/usr/local/bin:$PATH"
# Air-gap & telemetry suppression environment controls
ENV SEMGREP_SEND_METRICS=off
ENV BC_SKIP_MAPPING=TRUE
ENV SYFT_CHECK_FOR_APP_UPDATE=false
ENV GRYPE_CHECK_FOR_APP_UPDATE=false
ENV GRYPE_DB_AUTO_UPDATE=false

# ------------------------------------------------------------------------------
# 1. System Dependencies & OpenSCAP
# ------------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
    bash \
    ca-certificates \
    curl \
    git \
    jq \
    libopenscap25 \
    openssh-client \
    openssl \
    tar \
    && rm -rf /var/lib/apt/lists/*

# ------------------------------------------------------------------------------
# 2. Python-based Scanners: Semgrep & Checkov
# ------------------------------------------------------------------------------
# Debian glibc provides pre-compiled manylinux wheels for ARM64 and AMD64
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir \
       semgrep \
       checkov

# ------------------------------------------------------------------------------
# 3. Standalone Compiled Binaries: Gitleaks, Syft, Grype, Trivy
# ------------------------------------------------------------------------------
# Gitleaks (Secret Detection)
RUN ARCH=$(dpkg --print-architecture) \
    && if [ "$ARCH" = "arm64" ]; then GL_ARCH="arm64"; else GL_ARCH="x64"; fi \
    && curl -sSfL "https://github.com/gitleaks/gitleaks/releases/download/v8.18.4/gitleaks_8.18.4_linux_${GL_ARCH}.tar.gz" | tar -xz -C /usr/local/bin gitleaks \
    && chmod +x /usr/local/bin/gitleaks

# Syft (SBOM Generation)
RUN curl -sSfL https://raw.githubusercontent.com/anchore/syft/main/install.sh | sh -s -- -b /usr/local/bin

# Grype (CVE Vulnerability Scanning) + Pre-cache Vulnerability DB for --network none
RUN curl -sSfL https://raw.githubusercontent.com/anchore/grype/main/install.sh | sh -s -- -b /usr/local/bin \
    && GRYPE_DB_AUTO_UPDATE=true grype db update

# Trivy (Comprehensive Security Scanner) + Pre-cache Vulnerability DB for --network none
RUN curl -sfL https://raw.githubusercontent.com/aquasecurity/trivy/main/contrib/install.sh | sh -s -- -b /usr/local/bin \
    && trivy image --download-db-only

# ------------------------------------------------------------------------------
# 4. Verification Check: Confirm All Scanners Are Present and Executable
# ------------------------------------------------------------------------------
RUN echo "=== Verifying Security Tool Installations ===" \
    && semgrep --version \
    && checkov --version \
    && gitleaks version \
    && syft version \
    && grype version \
    && trivy --version \
    && (command -v oscap && oscap --version || echo "OpenSCAP library (libopenscap25) installed") \
    && echo "=== All Security Scanning Engines Verified Successfully ==="

# ------------------------------------------------------------------------------
# 5. Environment, Orchestration & Working Directories
# ------------------------------------------------------------------------------
COPY docker/scan_orchestrator.sh /usr/local/bin/scan_orchestrator.sh
RUN chmod +x /usr/local/bin/scan_orchestrator.sh

WORKDIR /workspace

# Default entrypoint allows interactive shell or direct tool invocation
ENTRYPOINT ["/bin/bash"]

